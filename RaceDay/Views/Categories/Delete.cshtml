@model RaceDay.Models.Category

@{
    ViewData["Title"] = $"Delete category - {ViewBag.EventName}";
}

<h1 class="h3">Delete category</h1>
<p class="text-muted">Event: <strong>@ViewBag.EventName</strong></p>
<hr />

<div class="alert alert-warning">
    Are you sure you want to delete the category <strong>@Model.Name</strong> (@Model.Kind)?
</div>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">Kind</dt>
    <dd class="col-sm-10">@Model.Kind</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" asp-route-eventId="@Model.EventId" class="btn btn-outline-secondary">Cancel</a>
</form>
